{
  "name": "websocket-learning",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "以 websocket.org 为主体内容的 WebSocket 协议学习项目",
  "scripts": {
    "exp": "tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "lint-staged": "^17.4.1",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,mjs,md,json,yaml,yml}": "eslint --fix"
  }
}
